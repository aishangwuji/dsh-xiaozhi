{
  "name": "@local/dsh-xiaozhi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Xiaozhi (小智) ESP32 device ingress for DeepSeek Harness: zero-touch OTA bootstrap, challenge/HMAC activation, user binding, and a mutually exclusive WebSocket gateway.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "systemmap/**"
  ],
  "scripts": {
    "build": "node build.mjs",
    "smoke": "node scripts/smoke-client.mjs",
    "check:ui": "node scripts/check-config-wizard.mjs",
    "check:role": "node scripts/check-role-preset.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
