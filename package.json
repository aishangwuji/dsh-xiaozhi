{
  "name": "dsh-xiaozhi-server",
  "version": "0.2.0",
  "type": "module",
  "description": "Xiaozhi (小智) ESP32 device ingress for DeepSeek Harness: zero-touch OTA bootstrap, LAN discovery, device approval, and a realtime voice pipeline (VAD / ASR / LLM / TTS) with a management console.",
  "license": "MIT",
  "author": "aishangwuji",
  "homepage": "https://github.com/aishangwuji/dsh-xiaozhi-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aishangwuji/dsh-xiaozhi-server.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "xiaozhi",
    "esp32",
    "voice",
    "asr",
    "tts",
    "mcp"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "smoke": "node scripts/smoke-client.mjs",
    "check:ui": "node scripts/check-config-wizard.mjs",
    "check:fonts": "node scripts/check-fonts.mjs",
    "check:role": "node scripts/check-role-preset.mjs",
    "check:card": "node scripts/check-agent-card.mjs",
    "check:devices": "node scripts/check-devices-dialog.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "check:voice": "node scripts/check-agent-voice.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
